# Build output. The per-arch test directories come from Tools/dev/zeq2linux.sh:
# the suites are native binaries, so a linux run cannot share tests/bin with the
# mac one.
/Build/
/tests/bin/
/tests/bin-linux-*/
.sanitize-build.log

# Game data. The ~324MB asset set ships separately from the source; a populated
# Build/<config>/ZEQ2/ is expected locally but must never be committed.
/Base/

# Local build configuration (documented in the Makefile as intentionally
# untracked so it can differ per machine).
Makefile.local

# Python bytecode from the Tools/dev scripts
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
*.swp
*~
